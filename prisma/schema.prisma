generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model chat_messages {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  role       String    @db.VarChar(20)
  content    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  image_url  String?
  user       user?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_chat_messages_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rates {
  currency   String    @id @db.VarChar(3)
  rate       Decimal   @db.Decimal(18, 6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model receipts {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String?   @db.Uuid
  date             DateTime? @default(now()) @db.Timestamptz(6)
  receipt_date     DateTime? @db.Timestamptz(6)
  merchant_name    String?   @db.VarChar(255)
  merchant_address String?
  city             String?   @db.VarChar(100)
  total            Decimal?  @db.Decimal(10, 2)
  currency         String?   @default("USD") @db.VarChar(3)
  tax              Decimal?  @default(0) @db.Decimal(10, 2)
  payment_method   String?   @db.VarChar(100)
  invoice_id       String?   @db.VarChar(255)
  category         String?   @default("General") @db.VarChar(100)
  tags             String[]
  type             String?   @default("Personal") @db.VarChar(50)
  workspace        String    @default("business") @db.VarChar(50)
  flow_type        String?   @default("expense") @db.VarChar(20)
  is_recurring     Boolean   @default(false)
  frequency        String?   @db.VarChar(50)
  recurring_active Boolean   @default(true)
  next_due_date    DateTime? @db.Timestamptz(6)
  month            String?   @db.VarChar(50)
  receipt_link     String?
  entry_status     String?   @default("completed") @db.VarChar(50)
  edited_fields    String?   @default("")
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  status           String    @default("DRAFT")
  user             user?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_receipts_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String          @unique @db.VarChar(255)
  email_verified         DateTime?       @db.Timestamptz(6)
  name                   String?
  image                  String?
  role                   String          @default("USER")
  password_hash          String?         @db.VarChar(255)
  first_name             String?         @db.VarChar(255)
  username               String?         @db.VarChar(255)
  notifications_enabled  Boolean         @default(false)
  avatar_url             String?
  currency               String?         @default("USD") @db.VarChar(3)
  status                 String?         @default("active") @db.VarChar(50)
  monthly_budget         Decimal?        @default(0) @db.Decimal(10, 2)
  reset_token            String?         @unique
  reset_token_expiry     DateTime?       @db.Timestamptz(6)
  pending_email          String?         @db.VarChar(255)
  pending_email_token    String?         @unique
  pending_email_expiry   DateTime?       @db.Timestamptz(6)
  created_at             DateTime?       @default(now()) @db.Timestamptz(6)
  notification_sent_day3 Boolean         @default(false)
  push_token             String?
  chat_messages          chat_messages[]
  receipts               receipts[]
}
